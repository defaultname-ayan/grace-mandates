# Razorpay TEST-MODE keys only. Never commit live keys.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# LLM provider: "gemini" (default) or "anthropic"
GRACE_PROVIDER=gemini

# Gemini -- create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternate provider
# ANTHROPIC_API_KEY=sk-ant-xxx

# Leave GRACE_MODEL empty to use the provider default
# (gemini-3.8-flash / claude-opus-5)
GRACE_MODEL=
GRACE_EFFORT=high
GRACE_BATCH_EFFORT=medium

# Decision thresholds
GRACE_THETA_LOW=0.15
GRACE_THETA_HIGH=0.60
